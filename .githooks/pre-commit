#!/bin/bash
# Pre-commit hook: clang-format check on staged C++ files
# Install: git config core.hooksPath .githooks

STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM | grep -E '\.(cpp|h|hpp)$' || true)

if [ -z "$STAGED_FILES" ]; then
    exit 0
fi

# Check if clang-format is available
if ! command -v clang-format &> /dev/null; then
    echo "WARNING: clang-format not found, skipping format check."
    exit 0
fi

echo "Running clang-format on staged files..."
CLANG_FORMAT_OUTPUT=$(clang-format -style=file --dry-run --Werror $STAGED_FILES 2>&1)
CLANG_FORMAT_EXIT=$?

if [ $CLANG_FORMAT_EXIT -ne 0 ]; then
    echo ""
    echo "ERROR: clang-format found style violations in:"
    echo "$CLANG_FORMAT_OUTPUT"
    echo ""
    echo "Fix with: clang-format -style=file -i <file>"
    echo "Or bypass with: git commit --no-verify"
    exit 1
fi

echo "clang-format check passed."
exit 0
